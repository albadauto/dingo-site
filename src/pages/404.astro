---
import Base from '../layouts/Base.astro'
---

<Base title="Página não encontrada" noindex>
  <section class="wrap flex flex-col items-center py-28 text-center">
    <img src="/logo.png" alt="" width="160" height="160" class="h-40 w-40 rounded-3xl" />
    <h1 class="mt-8 text-5xl font-extrabold">Essa trilha não leva a lugar nenhum.</h1>
    <p class="mt-4 max-w-md text-lg text-liquen">A página que você procurou não existe ou mudou de endereço.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">Voltar para o início</a>
      <a href="/blog/" class="btn-ghost">Ler o blog</a>
    </div>
  </section>
</Base>
