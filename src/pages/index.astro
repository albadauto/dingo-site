---
// Página inicial: para quem quer marcar um horário (busca) e, logo abaixo, para quem atende.
// A página completa para negócios fica em /para-negocios/.
import Base from '../layouts/Base.astro'
import ChatDemo from '../components/ChatDemo.astro'
import Faq from '../components/Faq.astro'
import { SITE } from '../site'
import { cities, searchUrl } from '../directory'

const cityList = (await cities()).slice(0, 12)

const kinds = [
  { type: 'barbearia', icon: '💈', title: 'Barbearia', text: 'Corte, barba e sobrancelha com o barbeiro que você prefere.' },
  { type: 'salao', icon: '💇‍♀️', title: 'Salão de beleza', text: 'Corte, escova, coloração, mechas e tratamentos.' },
  { type: 'nail', icon: '💅', title: 'Unhas', text: 'Manicure, pé e mão, alongamento, gel e manutenção.' },
  { type: 'micropigmentacao', icon: '✨', title: 'Sobrancelha e micro', text: 'Design, henna, micropigmentação e retoque.' },
]

const steps = [
  { n: '1', title: 'Encontre', text: 'Busque pelo bairro, pela cidade ou toque em “Perto de mim”. Você vê quem está aberto e o preço a partir de quanto.' },
  { n: '2', title: 'Escolha o horário', text: 'Serviço, profissional e um horário que está livre de verdade. Nada de esperar alguém responder a mensagem.' },
  { n: '3', title: 'Pronto', text: 'A confirmação chega no seu WhatsApp, e um lembrete antes do horário. Precisa remarcar? É só responder lá.' },
]

const forBusiness = [
  ['Atende o WhatsApp 24h', 'Uma IA responde preço, mostra os horários livres e marca, até de madrugada.'],
  ['Agenda, lembrete e retorno', 'Lembra o cliente na véspera e chama de volta na hora do próximo corte ou manutenção.'],
  ['Link para marcar sozinho', 'Na bio do Instagram, no status ou num QR code no balcão.'],
  ['Aparece nesta busca', 'Quem procura no seu bairro encontra você e já marca. Cliente novo sem pagar anúncio.'],
]

const faq = [
  {
    q: 'Preciso pagar alguma coisa para agendar?',
    a: 'Não. Para você, que vai marcar o horário, o Dingo é grátis. O pagamento do serviço é feito direto no estabelecimento, do jeito que ele aceita.',
  },
  {
    q: 'Tenho que baixar aplicativo ou criar conta?',
    a: 'Não. Você marca pelo navegador do celular, informando só o nome e o WhatsApp. A confirmação e o lembrete chegam por lá.',
  },
  {
    q: 'Como remarco ou cancelo?',
    a: 'Responda a mensagem de confirmação no WhatsApp do estabelecimento pedindo para remarcar ou cancelar. O horário volta para a agenda na hora.',
  },
  {
    q: 'O lugar que eu frequento não aparece. E agora?',
    a: 'Só aparecem os estabelecimentos que usam o Dingo e escolheram estar na busca. Indique o Dingo para o seu barbeiro, salão ou manicure: assim você passa a marcar com eles por aqui.',
  },
]

const indicate = encodeURIComponent(
  `Oi! Você já conhece o Dingo? Com ele dá pra eu marcar horário com você direto pelo celular, e uma IA responde o seu WhatsApp quando você está ocupado. Dá uma olhada: ${new URL('/para-negocios/', Astro.site)}`,
)

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: Astro.site?.toString(),
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${searchUrl}?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
]
---

<Base
  title="Encontre e agende barbearia, salão, unhas e sobrancelha"
  description="Encontre barbearias, salões, manicures e estúdios de sobrancelha perto de você e marque na hora, sem trocar mensagem. A confirmação chega no seu WhatsApp. Grátis e sem aplicativo."
  jsonLd={jsonLd}
  audience="cliente"
>
  <!-- Hero: busca -->
  <section class="relative overflow-hidden">
    <div class="wrap grid items-center gap-14 py-14 sm:py-20 lg:grid-cols-[1.25fr_1fr]">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-musgo px-3 py-1 text-sm text-liquen">
          <span class="h-1.5 w-1.5 rounded-full bg-folha"></span>
          Barbearias, salões, unhas e sobrancelha
        </p>
        <h1 class="mt-6 text-[clamp(2.6rem,5.6vw,4.25rem)] font-extrabold leading-[0.93]">
          Seu próximo horário, marcado em&nbsp;segundos.
        </h1>
        <p class="mt-6 max-w-xl text-lg text-liquen sm:text-xl">
          Encontre perto de você, veja os horários livres de verdade e marque sem trocar mensagem. A confirmação chega no seu WhatsApp.
        </p>

        <form action={searchUrl} method="get" class="mt-8 flex max-w-xl flex-col gap-2 sm:flex-row" role="search">
          <label class="flex flex-1 items-center gap-2 rounded-full bg-white px-5 text-tinta ring-1 ring-musgo focus-within:ring-2 focus-within:ring-pelagem">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-[#52695d]" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
            </svg>
            <span class="sr-only">Bairro ou cidade</span>
            <input name="q" required placeholder="Bairro ou cidade" autocomplete="address-level2" class="h-14 min-w-0 flex-1 bg-transparent text-base outline-none placeholder:text-[#52695d]" />
            <button class="hidden rounded-full bg-tinta px-4 py-2 text-sm font-bold text-giz hover:bg-tinta/85 sm:block">Buscar</button>
          </label>
          <a href={`${searchUrl}?perto=1`} class="btn-primary !h-14 !px-6 text-base">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <circle cx="12" cy="12" r="3"></circle><path d="M12 2v3M12 19v3M2 12h3M19 12h3" stroke-linecap="round"></path><circle cx="12" cy="12" r="7"></circle>
            </svg>
            Perto de mim
          </a>
        </form>
        <div class="mt-4 flex flex-wrap gap-2">
          {
            kinds.map((k) => (
              <a href={`${searchUrl}?tipo=${k.type}`} class="rounded-full border border-musgo px-3.5 py-1.5 text-sm text-liquen transition-colors hover:border-liquen hover:text-osso">
                <span aria-hidden="true">{k.icon}</span> {k.title}
              </a>
            ))
          }
        </div>
        <p class="mt-6 text-sm text-liquen">Grátis para você. Sem baixar aplicativo e sem criar conta.</p>
      </div>

      <!-- Prévia de como a cliente marca -->
      <div class="relative mx-auto w-full max-w-sm" aria-hidden="true">
        <div class="absolute -inset-10 -z-10 rounded-full bg-raposa/10 blur-3xl"></div>
        <div class="rounded-[32px] border border-musgo bg-mata p-3 shadow-2xl shadow-black/50">
          <div class="relative h-28 overflow-hidden rounded-[24px] bg-copa">
            <img src="/fox.png" alt="" width="200" height="200" class="absolute -right-6 -top-8 w-44 opacity-10" />
            <span class="absolute bottom-3 left-4 grid h-12 w-12 place-items-center rounded-2xl bg-noite font-display text-lg font-extrabold text-raposa">BZ</span>
          </div>
          <div class="px-2 pb-2 pt-4">
            <p class="font-display text-lg font-bold">Barbearia do Zé</p>
            <p class="text-sm text-liquen">Pinheiros, São Paulo · <span class="font-semibold text-folha">Aberto agora</span></p>
            <div class="mt-4 flex items-center justify-between rounded-2xl border border-raposa/60 bg-raposa/10 px-4 py-3 text-sm">
              <span><strong class="block">Corte + barba</strong><span class="text-liquen">50 min com o Rafa</span></span>
              <strong>R$ 70</strong>
            </div>
            <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-liquen">Sábado, 18</p>
            <div class="mt-2 grid grid-cols-4 gap-2 text-center text-sm">
              <span class="rounded-xl border border-musgo py-2">09:00</span>
              <span class="rounded-xl border border-musgo py-2 text-liquen/50 line-through">09:50</span>
              <span class="rounded-xl bg-raposa py-2 font-bold text-tinta">10:40</span>
              <span class="rounded-xl border border-musgo py-2">11:30</span>
            </div>
            <span class="mt-4 block rounded-full bg-raposa py-3 text-center text-sm font-bold text-tinta">Confirmar horário</span>
          </div>
        </div>
        <div class="relative z-10 -mt-2 ml-auto -mr-2 w-fit max-w-[260px] rounded-2xl rounded-br-md bg-[#1f6b47] px-4 py-3 text-sm text-giz shadow-xl shadow-black/30 sm:-mr-10">
          <span class="mb-0.5 block text-[11px] font-bold text-[#b6f0cf]">WhatsApp · Barbearia do Zé</span>
          ✅ Está marcado! Sábado, 10:40, corte + barba com o Rafa. Te lembro na véspera.
        </div>
      </div>
    </div>
  </section>

  <!-- Como funciona para você -->
  <section class="py-16 sm:py-24" aria-labelledby="voce-titulo">
    <div class="wrap">
      <h2 id="voce-titulo" class="max-w-2xl text-4xl font-extrabold leading-[1.05] sm:text-5xl">Sem esperar ninguém responder.</h2>
      <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
        {
          steps.map((s) => (
            <li class="border-t-2 border-raposa pt-6">
              <span class="font-display text-sm font-bold text-pelagem">Passo {s.n}</span>
              <h3 class="mt-2 text-2xl font-bold">{s.title}</h3>
              <p class="mt-2 text-liquen">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Tipos -->
  <section class="pb-16 sm:pb-24" aria-labelledby="tipos-titulo">
    <div class="wrap">
      <h2 id="tipos-titulo" class="text-3xl font-extrabold leading-[1.05] sm:text-4xl">O que você quer fazer?</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          kinds.map((k) => (
            <li>
              <a href={`${searchUrl}?tipo=${k.type}&perto=1`} class="group flex h-full flex-col rounded-3xl border border-musgo bg-mata/50 p-6 transition-colors hover:border-raposa/60">
                <span class="text-3xl" aria-hidden="true">{k.icon}</span>
                <h3 class="mt-4 text-xl font-bold group-hover:text-pelagem">{k.title}</h3>
                <p class="mt-2 flex-1 text-sm text-liquen">{k.text}</p>
                <span class="mt-5 text-sm font-semibold text-pelagem">Ver perto de mim →</span>
              </a>
            </li>
          ))
        }
      </ul>

      {
        cityList.length > 0 && (
          <div class="mt-12">
            <h3 class="text-lg font-bold">Onde já tem Dingo</h3>
            <div class="mt-4 flex flex-wrap gap-2">
              {cityList.map((c) => (
                <a href={`/encontre/${c.city_slug}/`} class="rounded-full border border-musgo px-4 py-2 text-sm transition-colors hover:border-liquen">
                  {c.city}/{c.state} <span class="text-liquen">· {c.total}</span>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- Para quem atende -->
  <section id="para-negocios" class="border-y border-musgo bg-mata/60 py-20 sm:py-28" aria-labelledby="negocio-titulo">
    <div class="wrap grid items-center gap-14 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <p class="text-sm font-bold uppercase tracking-wider text-pelagem">Para quem atende</p>
        <h2 id="negocio-titulo" class="mt-3 text-4xl font-extrabold leading-[1.02] sm:text-5xl">
          Tem barbearia, salão ou estúdio? O Dingo atende seu WhatsApp e ainda traz cliente novo.
        </h2>
        <dl class="mt-10 grid gap-x-10 sm:grid-cols-2">
          {
            forBusiness.map(([title, text]) => (
              <div class="border-t border-musgo py-5">
                <dt class="font-bold">{title}</dt>
                <dd class="mt-1 text-sm text-liquen">{text}</dd>
              </div>
            ))
          }
        </dl>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={SITE.signupUrl} class="btn-primary !px-6 !py-3.5 text-base">Testar {SITE.trialDays} dias grátis</a>
          <a href="/para-negocios/" class="btn-ghost !px-6 !py-3.5 text-base">Conhecer o Dingo para negócios</a>
        </div>
        <p class="mt-4 text-sm text-liquen">Sem cartão. Usa o número de WhatsApp que você já tem.</p>
      </div>
      <ChatDemo />
    </div>
  </section>

  <div class="border-b border-musgo">
    <Faq items={faq} lead="Para quem vai marcar um horário. Tem um negócio? Veja as perguntas na página para negócios." />
  </div>

  <!-- Indique -->
  <section class="py-20 sm:py-24">
    <div class="wrap">
      <div class="relative overflow-hidden rounded-[36px] bg-raposa px-6 py-12 text-tinta sm:px-14 sm:py-16">
        <img src="/fox.png" alt="" aria-hidden="true" width="420" height="420" loading="lazy" class="fox pointer-events-none absolute -bottom-24 -right-20 w-[280px] sm:w-[400px]" />
        <h2 class="relative max-w-2xl text-3xl font-extrabold leading-[1.05] sm:text-5xl">Queria marcar com o seu barbeiro por aqui?</h2>
        <p class="relative mt-4 max-w-lg text-lg font-medium text-tinta/80">Mande o Dingo para ele, para o seu salão ou para a sua manicure. Leva 10 minutos para começar.</p>
        <div class="relative mt-8 flex flex-wrap gap-3">
          <a href={`https://wa.me/?text=${indicate}`} target="_blank" rel="noopener" class="btn bg-tinta text-giz hover:bg-tinta/85">Indicar pelo WhatsApp</a>
          <a href={`${searchUrl}?perto=1`} class="btn border border-tinta/30 hover:bg-tinta/10">Buscar perto de mim</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .fox {
    filter: brightness(0);
    opacity: 0.14;
  }
</style>
