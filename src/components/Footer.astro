---
import { SITE } from '../site'
const year = new Date().getFullYear()
---

<footer class="border-t border-musgo">
  <div class="wrap grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <a href="/" class="flex items-center gap-2.5">
        <img src="/favicon.png" alt="" width="32" height="32" class="h-8 w-8 rounded-lg" />
        <span class="font-display text-xl font-extrabold text-raposa">Dingo</span>
      </a>
      <p class="mt-3 max-w-xs text-sm text-liquen">{SITE.tagline}.</p>
    </div>
    <nav aria-label="Produto">
      <p class="text-sm font-semibold">Produto</p>
      <ul class="mt-3 space-y-2 text-sm text-liquen">
        <li><a class="hover:text-osso" href="/#como-funciona">Como funciona</a></li>
        <li><a class="hover:text-osso" href="/precos/">Preços</a></li>
        <li><a class="hover:text-osso" href={SITE.signupUrl}>Testar grátis</a></li>
        <li><a class="hover:text-osso" href={SITE.loginUrl}>Entrar</a></li>
      </ul>
    </nav>
    <nav aria-label="Para quem">
      <p class="text-sm font-semibold">Para quem</p>
      <ul class="mt-3 space-y-2 text-sm text-liquen">
        <li><a class="hover:text-osso" href="/barbearias/">Barbearias</a></li>
        <li><a class="hover:text-osso" href="/saloes-de-beleza/">Salões de beleza</a></li>
        <li><a class="hover:text-osso" href="/micropigmentacao/">Micropigmentação</a></li>
        <li><a class="hover:text-osso" href="/nail-designers/">Nail designers</a></li>
        <li><a class="hover:text-osso" href="/blog/">Blog</a></li>
      </ul>
    </nav>
    <nav aria-label="Legal">
      <p class="text-sm font-semibold">Legal</p>
      <ul class="mt-3 space-y-2 text-sm text-liquen">
        <li><a class="hover:text-osso" href="/privacidade/">Privacidade</a></li>
        <li><a class="hover:text-osso" href="/termos/">Termos de uso</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap border-t border-musgo/60 py-6 text-xs text-liquen">© {year} Dingo. Feito no Brasil.</div>
</footer>
