---
import type { CollectionEntry } from 'astro:content'
import { formatDate } from '../lib'

interface Props {
  post: CollectionEntry<'blog'>
}
const { post } = Astro.props
---

<article class="group relative flex flex-col rounded-3xl border border-musgo p-6 transition-colors hover:border-raposa/60">
  <p class="text-xs text-liquen">
    <span class="text-pelagem">{post.data.category}</span> · <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
  </p>
  <h3 class="mt-3 text-xl font-bold leading-snug">
    <a href={`/blog/${post.id}/`} class="after:absolute after:inset-0">{post.data.title}</a>
  </h3>
  <p class="mt-2 flex-1 text-sm text-liquen">{post.data.description}</p>
  <span class="mt-5 text-sm font-semibold text-pelagem group-hover:underline">Ler artigo</span>
</article>
