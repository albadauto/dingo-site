---
import { SITE } from '../site'

const path = Astro.url.pathname
const links = [
  { href: '/#como-funciona', label: 'Como funciona' },
  { href: '/#para-quem', label: 'Para quem' },
  { href: '/precos/', label: 'Preços' },
  { href: '/blog/', label: 'Blog' },
]
const isActive = (href: string) => !href.includes('#') && path.startsWith(href)
---

<header class="sticky top-0 z-40 border-b border-musgo/60 bg-noite/85 backdrop-blur-md">
  <div class="wrap flex h-16 items-center gap-6">
    <a href="/" class="flex items-center gap-2.5" aria-label="Dingo, página inicial">
      <img src="/favicon.png" alt="" width="32" height="32" class="h-8 w-8 rounded-lg" />
      <span class="font-display text-xl font-extrabold text-raposa">Dingo</span>
    </a>

    <nav class="ml-4 hidden items-center gap-6 text-sm md:flex" aria-label="Principal">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={['transition-colors hover:text-osso', isActive(l.href) ? 'text-osso' : 'text-liquen']}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <a href={SITE.loginUrl} class="hidden px-3 py-2 text-sm text-liquen hover:text-osso sm:block">Entrar</a>
      <a href={SITE.signupUrl} class="btn-primary !px-4 !py-2.5">Testar grátis</a>
      <details class="relative md:hidden">
        <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-musgo text-liquen" aria-label="Abrir menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
          </svg>
        </summary>
        <div class="absolute right-0 mt-2 w-52 rounded-2xl border border-musgo bg-mata p-2 shadow-2xl shadow-black/40">
          {links.map((l) => <a href={l.href} class="block rounded-xl px-3 py-2.5 text-sm hover:bg-copa">{l.label}</a>)}
          <a href={SITE.loginUrl} class="block rounded-xl px-3 py-2.5 text-sm text-liquen hover:bg-copa">Entrar</a>
        </div>
      </details>
    </div>
  </div>
</header>
