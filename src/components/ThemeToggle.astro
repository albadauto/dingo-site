---
// Botão de modo claro/escuro. Sem escolha salva, segue o tema do aparelho.
---

<button
  type="button"
  data-theme-toggle
  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-musgo text-liquen transition-colors hover:border-liquen hover:text-osso"
  aria-label="Mudar para o modo claro"
  title="Modo claro ou escuro"
>
  <!-- sol (aparece no escuro) -->
  <svg class="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <!-- lua (aparece no claro) -->
  <svg class="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<style>
  .theme-moon {
    display: none;
  }
  :global(:root[data-theme='light']) .theme-sun {
    display: none;
  }
  :global(:root[data-theme='light']) .theme-moon {
    display: block;
  }
</style>

<script>
  const KEY = 'dingo.theme'
  const BG = { dark: '#011A10', light: '#F4F7F4' }
  const mq = window.matchMedia?.('(prefers-color-scheme: light)')

  const saved = () => {
    try {
      return localStorage.getItem(KEY)
    } catch {
      return null
    }
  }

  function apply(theme: 'light' | 'dark') {
    document.documentElement.dataset.theme = theme
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', BG[theme])
    document.querySelectorAll('[data-theme-toggle]').forEach((b) =>
      b.setAttribute('aria-label', theme === 'light' ? 'Mudar para o modo escuro' : 'Mudar para o modo claro'),
    )
  }

  apply(document.documentElement.dataset.theme === 'light' ? 'light' : 'dark')

  document.querySelectorAll('[data-theme-toggle]').forEach((b) =>
    b.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light'
      try {
        localStorage.setItem(KEY, next)
      } catch {
        /* sem armazenamento: vale só nesta página */
      }
      apply(next)
    }),
  )

  // Sem escolha salva, acompanha quando o aparelho troca de tema
  mq?.addEventListener?.('change', (e) => {
    const s = saved()
    if (s !== 'light' && s !== 'dark') apply(e.matches ? 'light' : 'dark')
  })
</script>
