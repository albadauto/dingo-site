---
import { FAQ, SITE } from '../site'

interface Props {
  items?: { q: string; a: string }[]
}
const { items = FAQ } = Astro.props
---

<section class="py-20 sm:py-28" aria-labelledby="faq-titulo">
  <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.6fr]">
    <div>
      <h2 id="faq-titulo" class="text-4xl font-extrabold leading-[1.05] sm:text-5xl">Perguntas frequentes</h2>
      <p class="mt-4 text-liquen">Não achou sua dúvida? Crie a conta e teste: são {SITE.trialDays} dias grátis, sem cartão.</p>
    </div>
    <div class="divide-y divide-musgo border-y border-musgo">
      {
        items.map((f) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-semibold">
              {f.q}
              <span class="mt-1 text-pelagem transition-transform group-open:rotate-45" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M12 5v14M5 12h14" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 max-w-2xl text-liquen">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
