---
import { SITE } from '../site'

interface Props {
  title?: string
}
const { title = 'Deixe o Dingo atender amanhã de manhã.' } = Astro.props
---

<section class="pb-24 pt-8">
  <div class="wrap">
    <div class="relative overflow-hidden rounded-[36px] bg-raposa px-6 py-14 text-noite sm:px-14 sm:py-20">
      <img
        src="/fox.png"
        alt=""
        aria-hidden="true"
        width="420"
        height="420"
        loading="lazy"
        class="fox pointer-events-none absolute -bottom-24 -right-20 w-[300px] sm:w-[440px]"
      />
      <h2 class="relative max-w-2xl text-4xl font-extrabold leading-[1.02] sm:text-6xl">{title}</h2>
      <p class="relative mt-4 max-w-lg text-lg font-medium text-noite/80">
        Crie a conta, escaneie o QR code e teste por {SITE.trialDays} dias. Sem cartão, sem fidelidade.
      </p>
      <div class="relative mt-8 flex flex-wrap gap-3">
        <a href={SITE.signupUrl} class="btn bg-noite text-osso hover:bg-mata">Começar teste grátis</a>
        <a href="/precos/" class="btn border border-noite/30 hover:bg-noite/10">Ver preços</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Raposa em silhueta escura sobre o laranja */
  .fox {
    filter: brightness(0);
    opacity: 0.14;
  }
</style>
