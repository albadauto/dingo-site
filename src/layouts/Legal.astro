---
import Base from './Base.astro'
import { COMPANY } from '../site'

interface Props {
  title: string
  description: string
}
const { title, description } = Astro.props
---

<Base title={title} description={description}>
  <article class="wrap py-16 sm:py-20">
    <h1 class="text-5xl font-extrabold">{title}</h1>
    <p class="mt-3 text-sm text-liquen">Última atualização: {COMPANY.updated}</p>
    <div class="prose prose-dingo mt-10 max-w-[70ch] prose-headings:font-display prose-h2:text-2xl">
      <slot />
    </div>
  </article>
</Base>
