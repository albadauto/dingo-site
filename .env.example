# Endereço público deste site, sem barra no final (sitemap, canonical, Open Graph)
SITE_URL=https://www.seudominio.com.br
# Endereço do painel (dingo-frontend): botões "Testar grátis" e "Entrar"
PUBLIC_APP_URL=https://app.seudominio.com.br
# API do Dingo (opcional). Com a busca aberta (SEARCH_ENABLED=true na API), o build gera
# as páginas /encontre/<cidade>/ e /encontre/<cidade>/<tipo>/ com os estabelecimentos.
PUBLIC_API_URL=https://api.seudominio.com.br
